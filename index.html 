<script src="script.js"></script>
  <script>
if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
        navigator.serviceWorker.register("./service-worker.js")
            .then(function (registro) {
                console.log(
                    "GrillCore: Service Worker registrado.",
                    registro.scope
                );
            })
            .catch(function (erro) {
                console.error(
                    "GrillCore: erro ao registrar Service Worker.",
                    erro
                );
            });
    });
}
    
  </script>





function atualizarUsuarioDashboard(){

    const usuario =
        localStorage.getItem(
            "grillcore_usuario"
        )
        ||
        "admin";


    const elemento =
        document.getElementById(
            "usuarioLogado"
        );


    if(elemento){

        elemento.textContent =
            usuario;

    }


    const mensagem =
        document.getElementById(
            "mensagemBoasVindas"
        );


    if(mensagem){

        mensagem.textContent =
            "Bem-vindo, " +
            usuario +
            "!";

    }

}



function atualizarResumoDashboard(){

    const produtos =
        typeof lerProdutos === "function"
            ? lerProdutos()
            : [];


    const clientes =
        typeof lerClientes === "function"
            ? lerClientes()
            : [];


    const vendas =
        typeof lerVendas === "function"
            ? lerVendas()
            : [];


    const entradas =
        typeof lerEntradas === "function"
            ? lerEntradas()
            : [];


    const produtosEl =
        document.getElementById(
            "totalProdutos"
        );


    const clientesEl =
        document.getElementById(
            "totalClientes"
        );


    const vendasEl =
        document.getElementById(
            "totalVendas"
        );


    const entradasEl =
        document.getElementById(
            "totalEntradas"
        );


    if(produtosEl){

        produtosEl.textContent =
            produtos.length;

    }


    if(clientesEl){

        clientesEl.textContent =
            clientes.length;

    }


    let totalVendas = 0;


    vendas.forEach(
        function(venda){

            const status =
                String(
                    venda.status || ""
                )
                .toLowerCase();


            if(
                status === "cancelada" ||
                status === "cancelado"
            ){

                return;

            }


            totalVendas +=
                typeof valorNumerico === "function"
                    ? valorNumerico(venda.total)
                    : Number(venda.total) || 0;

        }
    );


    let totalEntradas = 0;


    entradas.forEach(
        function(entrada){

            const status =
                String(
                    entrada.status || ""
                )
                .toLowerCase();


            if(
                status === "cancelada" ||
                status === "cancelado"
            ){

                return;

            }


            totalEntradas +=
                typeof valorNumerico === "function"
                    ? valorNumerico(entrada.valor)
                    : Number(entrada.valor) || 0;

        }
    );


    if(vendasEl){

        vendasEl.textContent =
            typeof dinheiro === "function"
                ? dinheiro(totalVendas)
                : totalVendas.toLocaleString(
                    "pt-BR",
                    {
                        style:"currency",
                        currency:"BRL"
                    }
                );

    }


    if(entradasEl){

        entradasEl.textContent =
            typeof dinheiro === "function"
                ? dinheiro(totalEntradas)
                : totalEntradas.toLocaleString(
                    "pt-BR",
                    {
                        style:"currency",
                        currency:"BRL"
                    }
                );

    }

}



let valoresOcultos =
    localStorage.getItem(
        "grillcore_dashboard_valores_ocultos"
    ) === "true";



function aplicarOcultacao(){

    const produtos =
        document.getElementById(
            "totalProdutos"
        );


    const clientes =
        document.getElementById(
            "totalClientes"
        );


    const vendas =
        document.getElementById(
            "totalVendas"
        );


    const entradas =
        document.getElementById(
            "totalEntradas"
        );


    if(!produtos){

        return;

    }


    if(valoresOcultos){

        produtos.textContent =
            "•••";


        clientes.textContent =
            "•••";


        vendas.textContent =
            "R$ •••";


        entradas.textContent =
            "R$ •••";

    }
    else{

        atualizarResumoDashboard();

    }


    const botao =
        document.getElementById(
            "botaoOlho"
        );


    if(botao){

        botao.textContent =
            valoresOcultos
                ? "😎"
                : "👁️";

    }

}



function alternarValores(){

    valoresOcultos =
        !valoresOcultos;


    localStorage.setItem(
        "grillcore_dashboard_valores_ocultos",
        valoresOcultos
            ? "true"
            : "false"
    );


    aplicarOcultacao();

}



document.addEventListener(
    "DOMContentLoaded",
    function(){

        atualizarUsuarioDashboard();

        atualizarResumoDashboard();

        aplicarOcultacao();

    }
);



window.addEventListener(
    "storage",
    function(){

        atualizarUsuarioDashboard();


        if(!valoresOcultos){

            atualizarResumoDashboard();

        }

    }
);



document.addEventListener(
    "visibilitychange",
    function(){

        if(
            document.visibilityState ===
            "visible"
        ){

            atualizarUsuarioDashboard();


            if(!valoresOcultos){

                atualizarResumoDashboard();

            }

        }

    }
);

